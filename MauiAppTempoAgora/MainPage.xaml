<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppTempoAgora.MainPage"
    Title="Tempo Agora">

    <VerticalStackLayout Padding="20" Spacing="12">
        <!-- Entry com x:Name para ser usado no C# -->
        <Entry x:Name="txt_cidade" Placeholder="Digite a cidade" />

        <!-- Botão que chama o método Button_Clicked -->
        <Button Text="Buscar previsão" Clicked="Button_Clicked"/>

        <!-- Label com x:Name para ser usado no C# -->
        <ScrollView>
            <Label x:Name="lbl_res"
                   LineBreakMode="WordWrap"
                   FontSize="16"
                   TextColor="Black"/>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>